    "hardhat:check-types": "yarn workspace @mdp-coin/hardhat check-types",
    "hardhat:clean": "yarn workspace @mdp-coin/hardhat clean",
    "hardhat:compile": "yarn workspace @mdp-coin/hardhat compile",
    "hardhat:deploy": "yarn workspace @mdp-coin/hardhat deploy",
    "hardhat:flatten": "yarn workspace @mdp-coin/hardhat flatten",
